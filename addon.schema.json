{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "addon.schema.json",
  "title": "RemoteCompanion add-on (API 1)",
  "description": "Describes an add-on file (ADDONS.md). It checks the shape; `addons validate <file>` also checks the references between parts.",
  "type": "object",
  "required": ["id", "name", "actions"],
  "properties": {
    "$schema": { "type": "string" },
    "api": { "type": "integer", "minimum": 1, "maximum": 1, "default": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "not": { "const": "addons" } },
    "name": { "type": "string", "minLength": 1 },
    "icon": { "$ref": "#/definitions/symbol" },
    "requires": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
    "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/action" } },
    "conditions": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
    "events": { "type": "array", "items": { "$ref": "#/definitions/event" } }
  },
  "definitions": {
    "word": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "symbol": { "type": "string", "description": "An SF Symbol name; for an add-on, also the name of a .png, .jpg or .jpeg file beside the JSON file (or an absolute path)." },
    "stateMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+$" },
      "additionalProperties": { "type": "string" }
    },
    "action": {
      "type": "object",
      "required": ["command", "name", "run"],
      "properties": {
        "command": { "type": "string", "pattern": "^[a-z0-9.-]+( [a-z0-9.-]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/definitions/symbol" },
        "options": { "type": "array", "items": { "$ref": "#/definitions/option" } },
        "input": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "placeholder": { "type": "string" },
            "number": { "type": "boolean" }
          }
        },
        "run": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } },
        "banner": { "$ref": "#/definitions/banner" }
      }
    },
    "option": {
      "type": "object",
      "required": ["id", "choices"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "not": { "pattern": "^(input|state|word[0-9]+)$" }
        },
        "title": { "type": "string" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["word"],
            "properties": {
              "word": { "$ref": "#/definitions/word" },
              "label": { "type": "string" },
              "value": { "type": ["string", "number", "boolean"] }
            }
          }
        },
        "skipWhen": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "step": {
      "type": "object",
      "description": "Exactly one kind key, plus the modifiers that kind allows.",
      "additionalProperties": false,
      "properties": {
        "notify": { "type": "string", "minLength": 1 },
        "defaults": {
          "type": "object",
          "required": ["domain", "key"],
          "properties": {
            "domain": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 },
            "value": {},
            "type": { "enum": ["string", "bool", "int"] },
            "toggle": { "type": "boolean" },
            "read": { "type": "boolean" },
            "as": { "type": "string", "minLength": 1 },
            "labels": {
              "type": "object",
              "properties": { "true": { "type": "string" }, "false": { "type": "string" } }
            }
          }
        },
        "exec": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "url": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "delay": { "type": "number", "minimum": 0 },
        "state": { "type": "number" },
        "root": { "type": "boolean" },
        "as": { "type": "string", "minLength": 1, "description": "With exec: keep the output in this variable instead of the reply." },
        "ifOptions": { "type": "boolean" },
        "if": {
          "type": "object",
          "required": ["var"],
          "properties": {
            "var": { "type": "string", "minLength": 1 },
            "is": {},
            "isNot": {},
            "unset": { "type": "boolean" }
          },
          "anyOf": [ { "required": ["is"] }, { "required": ["isNot"] }, { "required": ["unset"] } ]
        }
      },
      "oneOf": [
        { "required": ["notify"] },
        { "required": ["defaults"] },
        { "required": ["exec"] },
        { "required": ["url"] },
        { "required": ["command"] },
        { "required": ["delay"] }
      ]
    },
    "banner": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "icon": { "$ref": "#/definitions/symbol" },
        "hold": { "type": "number" },
        "await": { "type": "string" },
        "states": { "$ref": "#/definitions/stateMap" },
        "timeout": { "type": "number", "minimum": 1, "maximum": 30 }
      }
    },
    "condition": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/definitions/symbol" },
        "type": { "enum": ["number", "choice"] },
        "exec": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "root": { "type": "boolean" },
        "notifyState": { "type": "string", "minLength": 1 },
        "choices": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      },
      "anyOf": [ { "required": ["exec"] }, { "required": ["notifyState"] } ],
      "if": { "properties": { "type": { "const": "choice" } } },
      "then": { "required": ["choices"] }
    },
    "event": {
      "type": "object",
      "required": ["notify"],
      "properties": {
        "notify": { "type": "string", "minLength": 1 },
        "action": { "type": "string" },
        "banner": { "$ref": "#/definitions/banner" },
        "trigger": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "$ref": "#/definitions/word" },
            "name": { "type": "string", "minLength": 1 },
            "icon": { "$ref": "#/definitions/symbol" },
            "states": { "oneOf": [ { "$ref": "#/definitions/stateMap" }, { "const": false } ] }
          }
        }
      },
      "anyOf": [ { "required": ["banner"] }, { "required": ["trigger"] } ]
    }
  }
}
